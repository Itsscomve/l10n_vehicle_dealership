<odoo>
  <record id="fleet_vehicle_form_inherit_trade" model="ir.ui.view">
    <field name="name">vehicle.information.form.l10n.ve</field>
    <field name="model">vehicle.information</field>
    <field name="inherit_id" ref="vehicle_trade.vehicle_information_form_view" />
    <field name="arch" type="xml">
      <xpath expr="//field[@name='current_market_value']" position="after">
        <field name="customer_id" string="Cliente" invisible="not customer_id" />
        <field name="lot_id" string="Lote / Serie" readonly="1" invisible="not lot_id" />
        <field name="lot_body_serial" invisible="not lot_id" />
        <field name="lot_engine_serial" invisible="not lot_id" />
        <field name="lot_vehicle_plate" invisible="not lot_id" />
      </xpath>
    </field>
  </record>

</odoo>